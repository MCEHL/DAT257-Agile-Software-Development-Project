<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity" android:rotationX="0">
    <EditText
            android:layout_width="119dp"
            android:layout_height="41dp"
            android:inputType="text"
            android:text="Today"
            android:ems="10"
            android:id="@+id/editTextText"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="99dp"
            android:layout_marginEnd="102dp"
            app:layout_constraintEnd_toEndOf="parent" android:textSize="12sp" android:textAlignment="center"
            app:layout_constraintHorizontal_bias="0.494" android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/editTextText2" app:layout_constraintTop_toTopOf="parent"/>
    <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:text="Recommendations"
            android:ems="10"
            android:id="@+id/editTextText2" android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextText" app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="99dp" android:layout_marginEnd="102dp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="363dp" android:textAlignment="center"/>
    <Button
            android:text="This Week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/button"
            android:layout_marginTop="290dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextText2" app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="160dp" android:layout_marginEnd="161dp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="25dp"/>
    <EditText
            android:layout_width="198dp"
            android:layout_height="231dp"
            android:ems="10"
            android:id="@+id/editTextText3"
            android:gravity="top|start"
            android:scrollHorizontally="false"
            android:singleLine="false"
            android:ellipsize="none"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextText2" app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="105dp" android:layout_marginEnd="96dp"
            app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="235dp"
            app:layout_constraintBottom_toTopOf="@+id/button" app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintVertical_bias="0.0" android:inputType="textMultiLine"/>
    <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:ems="10"
            android:id="@+id/editTextText4" android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextText" app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="99dp" android:layout_marginEnd="102dp"
            app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="52dp"
            app:layout_constraintBottom_toTopOf="@+id/editTextText2" android:textAlignment="center"/>

    <!--ändrade text till textMultiLine recommendation från chatgpt-->

</androidx.constraintlayout.widget.ConstraintLayout>
